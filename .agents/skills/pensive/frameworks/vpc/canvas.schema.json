{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Pensive VPC state 1.0",
  "$comment": "Runtime additionally enforces globally unique identities, action boundaries, valid partial decisions and stale acceptance.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "framework",
    "schema_version",
    "content"
  ],
  "properties": {
    "annotations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "target",
          "target_label",
          "text"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
          },
          "target": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "type"
                ],
                "properties": {
                  "type": {
                    "const": "canvas"
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "type",
                  "id"
                ],
                "properties": {
                  "type": {
                    "const": "item"
                  },
                  "id": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "type",
                  "id"
                ],
                "properties": {
                  "type": {
                    "const": "section"
                  },
                  "id": {
                    "enum": [
                      "jobs",
                      "pains",
                      "gains",
                      "products_services",
                      "pain_relievers",
                      "gain_creators"
                    ]
                  }
                }
              }
            ]
          },
          "target_label": {
            "type": "string",
            "pattern": "\\S"
          },
          "text": {
            "type": "string",
            "pattern": "\\S"
          }
        }
      }
    },
    "framework": {
      "const": "vpc"
    },
    "schema_version": {
      "const": "1.0"
    },
    "content": {
      "$ref": "#/$defs/content"
    },
    "thoughts": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/thought"
          },
          {
            "$ref": "#/$defs/six_hats_thought"
          }
        ]
      }
    },
    "proposals": {
      "type": "array",
      "maxItems": 1,
      "items": {
        "$ref": "#/$defs/proposal"
      }
    }
  },
  "$defs": {
    "six_hats_thought": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "hat",
        "target",
        "target_label",
        "observations"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
        },
        "kind": {
          "const": "six_hats"
        },
        "hat": {
          "enum": [
            "white",
            "red",
            "black",
            "yellow",
            "green",
            "blue"
          ]
        },
        "target": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "type"
              ],
              "properties": {
                "type": {
                  "const": "canvas"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "type",
                "id"
              ],
              "properties": {
                "type": {
                  "enum": [
                    "item"
                  ]
                },
                "id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
                }
              }
            }
          ]
        },
        "target_label": {
          "type": "string",
          "pattern": "\\S"
        },
        "observations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "\\S"
          }
        },
        "suggestions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "\\S"
          }
        }
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "text"
      ],
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
        },
        "text": {
          "type": "string"
        }
      }
    },
    "thought": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "text"
      ],
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
        },
        "kind": {
          "enum": [
            "evaluation",
            "improvement"
          ]
        },
        "text": {
          "type": "string",
          "pattern": "\\S"
        }
      }
    },
    "content": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "framing",
        "jobs",
        "pains",
        "gains",
        "products_services",
        "pain_relievers",
        "gain_creators"
      ],
      "properties": {
        "framing": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "product_offering",
            "customer_segment",
            "scenario_job_context",
            "current_alternative",
            "success_metric"
          ],
          "properties": {
            "product_offering": {
              "type": "string"
            },
            "customer_segment": {
              "type": "string"
            },
            "scenario_job_context": {
              "type": "string"
            },
            "current_alternative": {
              "type": "string"
            },
            "success_metric": {
              "type": "string"
            }
          }
        },
        "jobs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/item"
          }
        },
        "pains": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/item"
          }
        },
        "gains": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/item"
          }
        },
        "products_services": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/item"
          }
        },
        "pain_relievers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/item"
          }
        },
        "gain_creators": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/item"
          }
        }
      }
    },
    "proposal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "action",
        "base_content",
        "content",
        "thought"
      ],
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
        },
        "action": {
          "const": "improve"
        },
        "base_content": {
          "$ref": "#/$defs/content"
        },
        "content": {
          "$ref": "#/$defs/content"
        },
        "thought": {
          "$ref": "#/$defs/thought"
        },
        "resolutions": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "jobs": {
              "enum": [
                "pending",
                "accepted",
                "rejected"
              ]
            },
            "pains": {
              "enum": [
                "pending",
                "accepted",
                "rejected"
              ]
            },
            "gains": {
              "enum": [
                "pending",
                "accepted",
                "rejected"
              ]
            },
            "products_services": {
              "enum": [
                "pending",
                "accepted",
                "rejected"
              ]
            },
            "pain_relievers": {
              "enum": [
                "pending",
                "accepted",
                "rejected"
              ]
            },
            "gain_creators": {
              "enum": [
                "pending",
                "accepted",
                "rejected"
              ]
            }
          }
        }
      }
    }
  }
}
