{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Pensive SWOT/TOWS state 1.0",
  "$comment": "Item IDs must additionally be unique across all factor and strategy collections; state.js enforces this semantic invariant. Optional thoughts/proposals extend version 1.0 without invalidating prior states. Action boundaries, cross-collection identity uniqueness and stale-acceptance checks are additionally enforced by state.js.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "framework",
    "schema_version",
    "content"
  ],
  "properties": {
    "takeaways": { "type": "string" },
    "annotations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "target",
          "target_label",
          "text"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
          },
          "target": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "type"
                ],
                "properties": {
                  "type": {
                    "const": "canvas"
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "type",
                  "id"
                ],
                "properties": {
                  "type": {
                    "enum": [
                      "factor",
                      "strategy"
                    ]
                  },
                  "id": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "type",
                  "id"
                ],
                "properties": {
                  "type": {
                    "const": "section"
                  },
                  "id": {
                    "enum": [
                      "strengths",
                      "weaknesses",
                      "opportunities",
                      "threats",
                      "so",
                      "st",
                      "wo",
                      "wt"
                    ]
                  }
                }
              }
            ]
          },
          "target_label": {
            "type": "string",
            "pattern": "\\S"
          },
          "text": {
            "type": "string",
            "pattern": "\\S"
          }
        }
      }
    },
    "framework": {
      "const": "swot"
    },
    "schema_version": {
      "const": "1.0"
    },
    "content": {
      "$ref": "#/$defs/content"
    },
    "thoughts": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/thought"
          },
          {
            "$ref": "#/$defs/six_hats_thought"
          }
        ]
      }
    },
    "proposals": {
      "type": "array",
      "maxItems": 1,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "action",
              "base_content",
              "content",
              "thought"
            ],
            "properties": {
              "id": {
                "type": "string",
                "maxLength": 128,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
              },
              "action": {
                "enum": [
                  "strategize",
                  "improve"
                ]
              },
              "base_content": {
                "$ref": "#/$defs/content"
              },
              "content": {
                "$ref": "#/$defs/content"
              },
              "thought": {
                "$ref": "#/$defs/thought"
              },
              "resolutions": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "strengths": {
                    "enum": [
                      "pending",
                      "accepted",
                      "rejected"
                    ]
                  },
                  "weaknesses": {
                    "enum": [
                      "pending",
                      "accepted",
                      "rejected"
                    ]
                  },
                  "opportunities": {
                    "enum": [
                      "pending",
                      "accepted",
                      "rejected"
                    ]
                  },
                  "threats": {
                    "enum": [
                      "pending",
                      "accepted",
                      "rejected"
                    ]
                  },
                  "so": {
                    "enum": [
                      "pending",
                      "accepted",
                      "rejected"
                    ]
                  },
                  "st": {
                    "enum": [
                      "pending",
                      "accepted",
                      "rejected"
                    ]
                  },
                  "wo": {
                    "enum": [
                      "pending",
                      "accepted",
                      "rejected"
                    ]
                  },
                  "wt": {
                    "enum": [
                      "pending",
                      "accepted",
                      "rejected"
                    ]
                  }
                }
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "action",
              "base_content",
              "base_takeaways",
              "takeaways",
              "rationale"
            ],
            "properties": {
              "action": {
                "enum": [
                  "formulate_takeaways",
                  "review_takeaways"
                ]
              },
              "base_content": {
                "$ref": "#/$defs/content"
              },
              "base_takeaways": {
                "type": "string"
              },
              "base_annotations": {
                "$ref": "#/properties/annotations"
              },
              "takeaways": {
                "type": "string",
                "minLength": 1
              },
              "rationale": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        ]
      }
    }
  },
  "$defs": {
    "six_hats_thought": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "hat",
        "target",
        "target_label",
        "observations"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
        },
        "kind": {
          "const": "six_hats"
        },
        "hat": {
          "enum": [
            "white",
            "red",
            "black",
            "yellow",
            "green",
            "blue"
          ]
        },
        "target": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "type"
              ],
              "properties": {
                "type": {
                  "const": "canvas"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "type",
                "id"
              ],
              "properties": {
                "type": {
                  "enum": [
                    "factor",
                    "strategy"
                  ]
                },
                "id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
                }
              }
            }
          ]
        },
        "target_label": {
          "type": "string",
          "pattern": "\\S"
        },
        "observations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "\\S"
          }
        },
        "suggestions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "\\S"
          }
        }
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "text"
      ],
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
        },
        "text": {
          "type": "string"
        }
      }
    },
    "content": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "framing",
        "strengths",
        "weaknesses",
        "opportunities",
        "threats",
        "strategies"
      ],
      "properties": {
        "framing": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "focal_entity",
            "objective",
            "environment"
          ],
          "properties": {
            "focal_entity": {
              "type": "string"
            },
            "objective": {
              "type": "string"
            },
            "environment": {
              "type": "string"
            }
          }
        },
        "strengths": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/item"
          }
        },
        "weaknesses": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/item"
          }
        },
        "opportunities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/item"
          }
        },
        "threats": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/item"
          }
        },
        "strategies": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "so",
            "st",
            "wo",
            "wt"
          ],
          "properties": {
            "so": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/item"
              }
            },
            "st": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/item"
              }
            },
            "wo": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/item"
              }
            },
            "wt": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/item"
              }
            }
          }
        }
      }
    },
    "thought": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "text"
      ],
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
        },
        "kind": {
          "enum": [
            "evaluation",
            "improvement",
            "strategize"
          ]
        },
        "text": {
          "type": "string",
          "pattern": "\\S"
        }
      }
    }
  }
}
