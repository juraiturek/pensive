{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Pensive SWOT/TOWS state 1.0",
  "$comment": "Item IDs must additionally be unique across all factor and strategy collections; state.js enforces this semantic invariant. Optional thoughts/proposals extend version 1.0 without invalidating prior states. Action boundaries, cross-collection identity uniqueness and stale-acceptance checks are additionally enforced by state.js.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "framework",
    "schema_version",
    "content"
  ],
  "properties": {
    "framework": {
      "const": "swot"
    },
    "schema_version": {
      "const": "1.0"
    },
    "content": {
      "$ref": "#/$defs/content"
    },
    "thoughts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/thought"
      }
    },
    "proposals": {
      "type": "array",
      "maxItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "action",
          "base_content",
          "content",
          "thought"
        ],
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
          },
          "action": {
            "enum": [
              "strategize",
              "improve"
            ]
          },
          "base_content": {
            "$ref": "#/$defs/content"
          },
          "content": {
            "$ref": "#/$defs/content"
          },
          "thought": {
            "$ref": "#/$defs/thought"
          }
        }
      }
    }
  },
  "$defs": {
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "text"
      ],
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
        },
        "text": {
          "type": "string"
        }
      }
    },
    "content": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "framing",
        "strengths",
        "weaknesses",
        "opportunities",
        "threats",
        "strategies"
      ],
      "properties": {
        "framing": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "focal_entity",
            "objective",
            "environment"
          ],
          "properties": {
            "focal_entity": {
              "type": "string"
            },
            "objective": {
              "type": "string"
            },
            "environment": {
              "type": "string"
            }
          }
        },
        "strengths": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/item"
          }
        },
        "weaknesses": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/item"
          }
        },
        "opportunities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/item"
          }
        },
        "threats": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/item"
          }
        },
        "strategies": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "so",
            "st",
            "wo",
            "wt"
          ],
          "properties": {
            "so": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/item"
              }
            },
            "st": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/item"
              }
            },
            "wo": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/item"
              }
            },
            "wt": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/item"
              }
            }
          }
        }
      }
    },
    "thought": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "text"
      ],
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
        },
        "kind": {
          "enum": [
            "evaluation",
            "improvement",
            "strategize"
          ]
        },
        "text": {
          "type": "string",
          "pattern": "\\S"
        }
      }
    }
  }
}
