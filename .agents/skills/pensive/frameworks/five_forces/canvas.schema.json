{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Pensive Five Forces state 1.0",
  "$comment": "Runtime additionally enforces globally unique identities, action boundaries, valid partial decisions and stale acceptance.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "framework",
    "schema_version",
    "content"
  ],
  "properties": {
    "takeaways": {
      "type": "string"
    },
    "annotations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "target",
          "target_label",
          "text"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
          },
          "target": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "type"
                ],
                "properties": {
                  "type": {
                    "const": "canvas"
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "type",
                  "id"
                ],
                "properties": {
                  "type": {
                    "const": "section"
                  },
                  "id": {
                    "enum": [
                      "new_entrants",
                      "substitutes",
                      "buyers",
                      "suppliers",
                      "rivalry"
                    ]
                  }
                }
              }
            ]
          },
          "target_label": {
            "type": "string",
            "pattern": "\\S"
          },
          "text": {
            "type": "string",
            "pattern": "\\S"
          }
        }
      }
    },
    "framework": {
      "const": "five_forces"
    },
    "schema_version": {
      "const": "1.0"
    },
    "content": {
      "$ref": "#/$defs/content"
    },
    "thoughts": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/thought"
          },
          {
            "$ref": "#/$defs/six_hats_thought"
          },
          {
            "$ref": "#/$defs/research_thought"
          }
        ]
      }
    },
    "proposals": {
      "type": "array",
      "maxItems": 1,
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/proposal"
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "action",
              "base_content",
              "base_takeaways",
              "takeaways",
              "rationale"
            ],
            "properties": {
              "action": {
                "enum": [
                  "formulate_takeaways",
                  "review_takeaways"
                ]
              },
              "base_content": {
                "$ref": "#/$defs/content"
              },
              "base_takeaways": {
                "type": "string"
              },
              "base_annotations": {
                "$ref": "#/properties/annotations"
              },
              "takeaways": {
                "type": "string",
                "minLength": 1
              },
              "rationale": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          {
            "$ref": "#/$defs/research_proposal"
          }
        ]
      }
    }
  },
  "$defs": {
    "six_hats_thought": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "hat",
        "target",
        "target_label",
        "observations"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
        },
        "kind": {
          "const": "six_hats"
        },
        "hat": {
          "enum": [
            "white",
            "red",
            "black",
            "yellow",
            "green",
            "blue"
          ]
        },
        "target": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "type"
              ],
              "properties": {
                "type": {
                  "const": "canvas"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "type",
                "id"
              ],
              "properties": {
                "type": {
                  "const": "section"
                },
                "id": {
                  "enum": [
                    "new_entrants",
                    "substitutes",
                    "buyers",
                    "suppliers",
                    "rivalry"
                  ]
                }
              }
            }
          ]
        },
        "target_label": {
          "type": "string",
          "pattern": "\\S"
        },
        "observations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "\\S"
          }
        },
        "suggestions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "\\S"
          }
        }
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "text"
      ],
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
        },
        "text": {
          "type": "string"
        }
      }
    },
    "thought": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "text"
      ],
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
        },
        "kind": {
          "enum": [
            "evaluation",
            "improvement"
          ]
        },
        "text": {
          "type": "string",
          "pattern": "\\S"
        }
      }
    },
    "content": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "framing",
        "new_entrants",
        "substitutes",
        "buyers",
        "suppliers",
        "rivalry"
      ],
      "properties": {
        "framing": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "industry",
            "geography",
            "objective",
            "rivals",
            "buyers",
            "suppliers",
            "substitutes",
            "entrants"
          ],
          "properties": {
            "industry": {
              "type": "string"
            },
            "geography": {
              "type": "string"
            },
            "objective": {
              "type": "string"
            },
            "rivals": {
              "type": "string"
            },
            "buyers": {
              "type": "string"
            },
            "suppliers": {
              "type": "string"
            },
            "substitutes": {
              "type": "string"
            },
            "entrants": {
              "type": "string"
            }
          }
        },
        "new_entrants": {
          "$ref": "#/$defs/force"
        },
        "substitutes": {
          "$ref": "#/$defs/force"
        },
        "buyers": {
          "$ref": "#/$defs/force"
        },
        "suppliers": {
          "$ref": "#/$defs/force"
        },
        "rivalry": {
          "$ref": "#/$defs/force"
        }
      }
    },
    "proposal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "action",
        "base_content",
        "content",
        "thought"
      ],
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
        },
        "action": {
          "const": "improve"
        },
        "base_content": {
          "$ref": "#/$defs/content"
        },
        "content": {
          "$ref": "#/$defs/content"
        },
        "thought": {
          "$ref": "#/$defs/thought"
        },
        "resolutions": {
          "type": "object",
          "additionalProperties": false,
          "required": [],
          "properties": {
            "new_entrants": {
              "enum": [
                "pending",
                "accepted",
                "rejected"
              ]
            },
            "substitutes": {
              "enum": [
                "pending",
                "accepted",
                "rejected"
              ]
            },
            "buyers": {
              "enum": [
                "pending",
                "accepted",
                "rejected"
              ]
            },
            "suppliers": {
              "enum": [
                "pending",
                "accepted",
                "rejected"
              ]
            },
            "rivalry": {
              "enum": [
                "pending",
                "accepted",
                "rejected"
              ]
            }
          }
        },
        "target": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "type"
              ],
              "properties": {
                "type": {
                  "const": "canvas"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "type",
                "id"
              ],
              "properties": {
                "type": {
                  "const": "section"
                },
                "id": {
                  "enum": [
                    "new_entrants",
                    "substitutes",
                    "buyers",
                    "suppliers",
                    "rivalry"
                  ]
                }
              }
            }
          ]
        }
      }
    },
    "research_source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "url"
      ],
      "properties": {
        "title": {
          "type": "string",
          "pattern": "\\S"
        },
        "url": {
          "type": "string",
          "pattern": "^https?://[^\\s\\\\]+$"
        }
      }
    },
    "research_thought": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "text",
        "sources"
      ],
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
        },
        "kind": {
          "const": "research"
        },
        "text": {
          "type": "string",
          "pattern": "\\S"
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/research_source"
          }
        }
      }
    },
    "research_proposal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action",
        "target",
        "base_content",
        "report",
        "sources"
      ],
      "properties": {
        "action": {
          "const": "research"
        },
        "target": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "type"
              ],
              "properties": {
                "type": {
                  "const": "canvas"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "type",
                "id"
              ],
              "properties": {
                "type": {
                  "const": "section"
                },
                "id": {
                  "enum": [
                    "new_entrants",
                    "substitutes",
                    "buyers",
                    "suppliers",
                    "rivalry"
                  ]
                }
              }
            }
          ]
        },
        "base_content": {
          "$ref": "#/$defs/content"
        },
        "content": {
          "$ref": "#/$defs/content"
        },
        "report": {
          "type": "string",
          "pattern": "\\S"
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/research_source"
          }
        },
        "base_thoughts": {
          "$ref": "#/properties/thoughts"
        },
        "base_annotations": {
          "$ref": "#/properties/annotations"
        }
      }
    },
    "trajectory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "direction",
        "horizon",
        "confidence",
        "analysis",
        "research_notes"
      ],
      "properties": {
        "direction": {
          "enum": [
            null,
            "increasing",
            "decreasing",
            "stable",
            "uncertain"
          ]
        },
        "horizon": {
          "type": "string"
        },
        "confidence": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "analysis": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/item"
          }
        },
        "research_notes": {
          "type": "string"
        }
      }
    },
    "force": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "strength",
        "confidence",
        "analysis",
        "research_notes"
      ],
      "properties": {
        "strength": {
          "enum": [
            null,
            "very_weak",
            "weak",
            "moderate",
            "strong",
            "very_strong"
          ]
        },
        "confidence": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "analysis": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/item"
          }
        },
        "research_notes": {
          "type": "string"
        },
        "trajectory": {
          "$ref": "#/$defs/trajectory"
        }
      }
    }
  }
}
