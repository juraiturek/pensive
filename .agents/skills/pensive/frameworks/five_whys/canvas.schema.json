{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Pensive 5 Whys",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "framework",
    "schema_version",
    "content",
    "cursor"
  ],
  "properties": {
    "framework": {
      "const": "five_whys"
    },
    "schema_version": {
      "const": "1.0"
    },
    "content": {
      "$ref": "#/$defs/content"
    },
    "cursor": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "thoughts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "text"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
          },
          "kind": {
            "enum": [
              "evaluation",
              "expansion"
            ]
          },
          "text": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "proposals": {
      "type": "array",
      "maxItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "action",
          "target",
          "mode",
          "parent_id",
          "base_content",
          "children",
          "thought"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
          },
          "action": {
            "const": "expand"
          },
          "target": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "id"
            ],
            "properties": {
              "type": {
                "const": "node"
              },
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
              }
            }
          },
          "mode": {
            "enum": [
              "deepen",
              "branch"
            ]
          },
          "parent_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
          },
          "base_content": {
            "$ref": "#/$defs/content"
          },
          "children": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/node"
            }
          },
          "thought": {
            "$ref": "#/$defs/thought"
          }
        }
      }
    }
  },
  "$defs": {
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "text",
        "children",
        "is_terminal",
        "output"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
        },
        "text": {
          "type": "string"
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/node"
          }
        },
        "is_terminal": {
          "type": "boolean"
        },
        "output": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "thought": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "text"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
        },
        "kind": {
          "enum": [
            "evaluation",
            "expansion"
          ]
        },
        "text": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "content": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "framing",
        "tree"
      ],
      "properties": {
        "framing": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "observable_symptom",
            "expected_condition",
            "system_or_process",
            "investigation_owner"
          ],
          "properties": {
            "observable_symptom": {
              "type": "string"
            },
            "expected_condition": {
              "type": "string"
            },
            "system_or_process": {
              "type": "string"
            },
            "investigation_owner": {
              "type": "string"
            }
          }
        },
        "tree": {
          "$ref": "#/$defs/node"
        }
      }
    }
  }
}
